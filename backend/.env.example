# Copiar como .env y completar con valores reales. NUNCA commitear el .env real
# (ya está en .gitignore) -- este archivo es solo la plantilla, sin secretos.

database_host=localhost
database_port=5432
database_name=homesolutionsdb
database_user=postgres
database_password=

# Generar uno propio por ambiente, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# "development" en local. Pasar a "production" en el deploy real (Railway):
# activa el flag "secure" de las cookies de sesión, que requiere HTTPS.
ENVIRONMENT=development

# Orígenes permitidos por CORS, separados por coma. En producción, el
# dominio de Vercel (y el dominio propio si lo hay).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Lectura automática de comprobantes con IA (botón "Autocompletar con IA" en
# los modales de Gasto/Compra/Cobro). Sacar la key gratis en
# https://aistudio.google.com/apikey. Sin esto, esa función da error 502
# pero el resto de la app funciona igual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Cuando se conecte Cloudflare R2 para los comprobantes, agregar acá:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
