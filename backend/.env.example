# Copiar como .env y completar con valores reales. NUNCA commitear el .env real
# (ya está en .gitignore) -- este archivo es solo la plantilla, sin secretos.

database_host=localhost
database_port=5432
database_name=homesolutionsdb
database_user=postgres
database_password=

# Generar uno propio por ambiente, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token de larga duración, en cookie separada (ver POST /auth/refresh).
REFRESH_TOKEN_EXPIRE_DAYS=7

# Nota: los usuarios autorizados a autoregistrarse ya no se configuran acá.
# Viven en la tabla usuarios_autorizados y los gestiona la cuenta "Manager"
# desde la app (ver routes/usuarios.py).

# "development" en local. Pasar a "production" en el deploy real (Railway):
# activa el flag "secure" de las cookies de sesión, que requiere HTTPS.
ENVIRONMENT=development

# Orígenes permitidos por CORS, separados por coma. En producción:
# FRONTEND_ORIGINS=https://homesolutions.company,https://www.homesolutions.company
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookies de sesión (ver app/routes/login.py). Dejar vacías/comentadas
# mientras front y back estén en dominios de distinto "site" (ej. Vercel +
# Railway sin dominio propio) -- ahí las cookies necesitan
# SameSite=None (comportamiento default en producción, no hace falta
# setear nada acá). Una vez que front (homesolutions.company) y back
# (api.homesolutions.company) compartan dominio raíz, seteá:
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN dejarla vacía salvo que otro subdominio necesite compartir
# la misma cookie -- no hace falta para que front y back se hablen.
# COOKIE_SAMESITE=
# COOKIE_DOMAIN=

# Lectura automática de comprobantes con IA (botón "Autocompletar con IA" en
# los modales de Gasto/Compra/Cobro). Sacar la key gratis en
# https://aistudio.google.com/apikey. Sin esto, esa función da error 502
# pero el resto de la app funciona igual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Almacenamiento de comprobantes en un bucket S3-compatible (en producción:
# el Storage Bucket de Railway). Dejar las 4 obligatorias vacías/comentadas en
# local: sin ellas, app/files/storage.py guarda los archivos en disco
# (comportamiento de siempre). En producción hay que completarlas ANTES de
# subir comprobantes reales, porque el disco de Railway no persiste entre
# deploys o reinicios y los archivos se perderían.
# En Railway: bucket > pestaña "Credentials". En el servicio del backend se
# cargan como referencias a las variables del bucket:
# S3_ENDPOINT_URL=       (ENDPOINT del bucket, ej. https://t3.storageapi.dev)
# S3_ACCESS_KEY_ID=      (ACCESS_KEY_ID del bucket)
# S3_SECRET_ACCESS_KEY=  (SECRET_ACCESS_KEY del bucket)
# S3_BUCKET_NAME=        (BUCKET del bucket -- NO RAILWAY_BUCKET_NAME)
# S3_REGION=auto         (opcional: REGION del bucket, default "auto")
# S3_ADDRESSING_STYLE=virtual  (opcional: "path" solo si Credentials lo pide)
