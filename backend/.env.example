# Copiar como .env y completar con valores reales. NUNCA commitear el .env real
# (ya está en .gitignore) -- este archivo es solo la plantilla, sin secretos.

database_host=localhost
database_port=5432
database_name=homesolutionsdb
database_user=postgres
database_password=

# Generar uno propio por ambiente, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token de larga duración, en cookie separada (ver POST /auth/refresh).
REFRESH_TOKEN_EXPIRE_DAYS=7

# Nota: los usuarios autorizados a autoregistrarse ya no se configuran acá.
# Viven en la tabla usuarios_autorizados y los gestiona la cuenta "Manager"
# desde la app (ver routes/usuarios.py).

# "development" en local. Pasar a "production" en el deploy real (Railway):
# activa el flag "secure" de las cookies de sesión, que requiere HTTPS.
ENVIRONMENT=development

# Orígenes permitidos por CORS, separados por coma. En producción, el
# dominio de Vercel (y el dominio propio si lo hay).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Lectura automática de comprobantes con IA (botón "Autocompletar con IA" en
# los modales de Gasto/Compra/Cobro). Sacar la key gratis en
# https://aistudio.google.com/apikey. Sin esto, esa función da error 502
# pero el resto de la app funciona igual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Almacenamiento de comprobantes en Cloudflare R2. Dejar las 4 vacías/comentadas
# en local: sin ellas, app/files/storage.py guarda los archivos en disco
# (comportamiento de siempre). En producción (Railway) hay que completarlas
# ANTES de subir comprobantes reales, porque el disco de Railway no persiste
# entre deploys o reinicios y los archivos se perderían.
# Sacar los valores en Cloudflare > R2 > "Manage API tokens":
# R2_ACCOUNT_ID=        (aparece en la URL del dashboard de Cloudflare)
# R2_ACCESS_KEY_ID=     (lo da el token de API que crees para R2)
# R2_SECRET_ACCESS_KEY= (idem, solo se muestra una vez al crear el token)
# R2_BUCKET_NAME=       (nombre del bucket, ej. homesolutions-comprobantes)
